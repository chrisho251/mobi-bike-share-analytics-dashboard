<mxfile host="app.diagrams.net">
  <diagram id="arch" name="High-Level Architecture">
    <mxGraphModel dx="1500" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Mobi Bike-Share Rebalancing Dashboard&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;High-level architecture (all components run on free tiers)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="900" height="50" as="geometry"/>
        </mxCell>

        <!-- Lane 1: Data sources -->
        <mxCell id="lane_src" value="1 · DATA SOURCES" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#f0f6fd;strokeColor=#6c8ebf;strokeWidth=2;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="260" height="440" as="geometry"/>
        </mxCell>
        <mxCell id="src_gbfs" value="&lt;b&gt;Mobi GBFS API&lt;/b&gt;&lt;br&gt;station_status (live bikes / docks)&lt;br&gt;station_information (name, location)&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;REST · JSON · refreshed every 60 s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="125" width="220" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="src_wx" value="&lt;b&gt;Open-Meteo API&lt;/b&gt;&lt;br&gt;Hourly temperature, rain, wind&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;REST · JSON · free, no API key&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="275" width="220" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="src_trip" value="&lt;b&gt;Mobi trip history&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;CSV · optional, if time allows&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="415" width="220" height="70" as="geometry"/>
        </mxCell>

        <!-- Lane 2: Scheduled pipeline -->
        <mxCell id="lane_pipe" value="2 · SCHEDULED PIPELINE" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#fff8ee;strokeColor=#d79b00;strokeWidth=2;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="350" y="80" width="380" height="440" as="geometry"/>
        </mxCell>
        <mxCell id="pipe_gha" value="&lt;b&gt;GitHub Actions&lt;/b&gt; · cron every 10 min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="375" y="120" width="330" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="pipe_1" value="&lt;b&gt;1 · Ingest&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;requests · SQLAlchemy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="395" y="185" width="290" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="pipe_2" value="&lt;b&gt;2 · Fill actual values&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;pandas · compares past predictions with reality&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="395" y="265" width="290" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="pipe_3" value="&lt;b&gt;3 · Retrain model (hourly)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;scikit-learn (HistGradientBoosting) · joblib&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="395" y="345" width="290" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="pipe_4" value="&lt;b&gt;4 · Predict + self-correct&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;bikes in 60 min · bias correction from recent errors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="395" y="425" width="290" height="55" as="geometry"/>
        </mxCell>

        <!-- Lane 3: Storage -->
        <mxCell id="lane_db" value="3 · STORAGE" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#f3f9f1;strokeColor=#82b366;strokeWidth=2;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="780" y="80" width="300" height="440" as="geometry"/>
        </mxCell>
        <mxCell id="db_neon" value="&lt;b&gt;Neon Serverless Postgres&lt;/b&gt;&lt;br&gt;&lt;br&gt;stations&lt;br&gt;station_status&lt;br&gt;weather_hourly&lt;br&gt;predictions_log&lt;br&gt;model_runs&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;one database · SQLAlchemy + psycopg&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="815" y="125" width="230" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="db_note" value="&lt;b&gt;Two roles&lt;/b&gt;&lt;br&gt;pipeline: read + write&lt;br&gt;dashboard: read-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="815" y="405" width="230" height="75" as="geometry"/>
        </mxCell>

        <!-- Lane 4: Serving -->
        <mxCell id="lane_app" value="4 · DASHBOARD" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#f8f3fb;strokeColor=#9673a6;strokeWidth=2;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1130" y="80" width="300" height="440" as="geometry"/>
        </mxCell>
        <mxCell id="app_render" value="&lt;b&gt;Render&lt;/b&gt; · free web service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1150" y="120" width="260" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="app_gradio" value="&lt;b&gt;Gradio app&lt;/b&gt;&lt;br&gt;auto-refresh every 60 s&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;Gradio · Plotly · pandas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1150" y="185" width="260" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="app_tabs" value="&lt;b&gt;Four tabs&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;padding-left:30px&quot;&gt;1 · Live Overview&lt;br&gt;2 · Next-Hour Actions&lt;br&gt;3 · Forecast Accuracy&lt;br&gt;4 · Station Explorer&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1150" y="295" width="260" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="app_note" value="&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;Only reads the database.&lt;br&gt;No model training here.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1150" y="440" width="260" height="40" as="geometry"/>
        </mxCell>

        <!-- Users -->
        <mxCell id="users" value="&lt;b&gt;Mobi dispatcher&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;(and the instructor) in a web browser&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="1255" y="560" width="30" height="60" as="geometry"/>
        </mxCell>

        <!-- Lane 5: Development tooling -->
        <mxCell id="lane_dev" value="DEVELOPMENT TOOLING" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1040" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="dev_git" value="&lt;b&gt;GitHub repository&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;source code · Actions secrets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="610" width="220" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="dev_uv" value="&lt;b&gt;uv&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;dependencies · virtual env&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="310" y="610" width="200" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="dev_neon" value="&lt;b&gt;Neon CLI + neon.ts&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;provisions the database&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="540" y="610" width="220" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="dev_test" value="&lt;b&gt;pytest&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;automated checks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="790" y="610" width="270" height="65" as="geometry"/>
        </mxCell>

        <!-- Data-flow edges -->
        <mxCell id="e1" value="HTTP GET" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#6c8ebf;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="src_gbfs" target="pipe_1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="325" y="182"/>
              <mxPoint x="325" y="201"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" value="HTTP GET" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#6c8ebf;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="src_wx" target="pipe_1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="325" y="327"/>
              <mxPoint x="325" y="223"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#d79b00;" edge="1" parent="1" source="pipe_1" target="pipe_2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#d79b00;" edge="1" parent="1" source="pipe_2" target="pipe_3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#d79b00;" edge="1" parent="1" source="pipe_3" target="pipe_4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="write (SQL)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;startArrow=block;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="lane_pipe" target="db_neon">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="read-only SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1" source="db_neon" target="app_gradio">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;startArrow=block;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1" source="lane_app" target="users">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Tooling edges -->
        <mxCell id="e9" value="runs the code" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;dashed=1;endArrow=open;strokeColor=#666666;fontSize=11;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dev_git" target="lane_pipe">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="225" y="548"/>
              <mxPoint x="540" y="548"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e10" value="auto-deploys" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;dashed=1;endArrow=open;strokeColor=#666666;fontSize=11;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dev_git" target="app_render">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="115" y="535"/>
              <mxPoint x="1105" y="535"/>
              <mxPoint x="1105" y="140"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
